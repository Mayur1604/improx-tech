# Improx Tech Environment Configuration Example
# Copy this file to .env.local to configure automated contact form delivery.

# ==============================================================================
# Contact Form Delivery Settings
# ==============================================================================
# Resend API Key (Sign up at https://resend.com)


# Recipient address for inquiries submitted through the contact form
CONTACT_TO_EMAIL=enquiry@improxgroup.com
RESEND_API_KEY=re_your_api_key_here
# Verified sender address configured in your Resend domain settings
# Use 'onboarding@resend.dev' for sandbox testing, or 'website@improxgroup.com' when domain is verified.
CONTACT_FROM_EMAIL=onboarding@resend.dev
to: ["mayurkulkarni345@gmail.com"],
# ==============================================================================
# Site Metadata
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://improxtech.com
